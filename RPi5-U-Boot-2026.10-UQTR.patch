+	struct udevice *dev;
+	int err;
+
+	rpi5_diag("RP1 PCI find/probe");
+	err = dm_pci_find_device(PCI_VENDOR_ID_RPI, PCI_DEVICE_ID_RPI_RP1_C0,
+				 0, &dev);
+	rpi5_diag_result("RP1 find/probe returned", err);
+	if (err) {
