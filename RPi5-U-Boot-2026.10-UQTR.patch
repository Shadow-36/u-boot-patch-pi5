diff --git a/board/raspberrypi/rpi/rpi5_diag.c b/board/raspberrypi/rpi/rpi5_diag.c
new file mode 100644
--- /dev/null
+++ b/board/raspberrypi/rpi/rpi5_diag.c
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Pi 5 raw framebuffer diagnostics. No fonts, stdio or video_sync(). */
+#include <cpu_func.h>
+#include <dm.h>
+#include <rpi5_diag.h>
+#include <video.h>
+#include <linux/string.h>
+#include <asm/cache.h>
+#include <asm/global_data.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+static struct udevice *diag_video;
+
+/* draw_panel() bounds-checks the whole panel before these pixel writes. */
+static void rect(struct video_priv *p, int x, int y, int w, int h, u32 color)
+{
+	int row, col;
+
+	for (row = y; row < y + h; row++) {
+		volatile u32 *dst = (void *)((u8 *)p->fb +
+					   row * p->line_length + x * 4);
+
+		for (col = 0; col < w; col++)
+			dst[col] = color;
+	}
+}
+
+/* Seven segments drawn as rectangles: independent of the text console. */
+static void digit(struct video_priv *p, int x, int y, unsigned int n)
+{
+	static const u8 masks[] = {
+		0x3f, 0x06, 0x5b, 0x4f, 0x66,
+		0x6d, 0x7d, 0x07, 0x7f, 0x6f
+	};
+	static const u8 box[7][4] = {
+		{8, 0, 32, 8}, {40, 8, 8, 32}, {40, 48, 8, 32},
+		{8, 80, 32, 8}, {0, 48, 8, 32}, {0, 8, 8, 32},
+		{8, 40, 32, 8}
+	};
+	unsigned int i;
+
+	for (i = 0; i < 7; i++)
+		if (masks[n % 10] & (1U << i))
+			rect(p, x + box[i][0], y + box[i][1],
+			     box[i][2], box[i][3], 0xffffffff);
+}
+
+static void draw_panel(struct udevice *dev, unsigned int code, int result)
+{
+	struct video_priv *p = dev_get_uclass_priv(dev);
+	unsigned long start, end;
+	unsigned int rc = result < 0 ? -(unsigned int)result : result;
+
+	/* Targets the mailbox driver's requested 32-bit framebuffer. */
+	if (!p->fb || p->bpix != VIDEO_BPP32 || p->xsize < 416 ||
+	    p->ysize < 136 || p->line_length < p->xsize * 4 ||
+	    (unsigned long)p->line_length * 136 > p->fb_size)
+		return;
+
+	rect(p, 8, 8, 408, 128, 0xffffffff);
+	rect(p, 12, 12, 400, 120, 0xff202020);
+	digit(p, 24, 28, code / 100);
+	digit(p, 80, 28, code / 10);
+	digit(p, 136, 28, code);
+	/* Right digits are absolute return value modulo 1000; bar = negative. */
+	digit(p, 232, 28, rc / 100);
+	digit(p, 288, 28, rc / 10);
+	digit(p, 344, 28, rc);
+	if (result < 0)
+		rect(p, 204, 68, 20, 8, 0xffffffff);
+	/* Small dot is white after relocation, black before relocation. */
+	rect(p, 24, 120, 8, 8,
+	     gd->flags & GD_FLG_RELOC ? 0xffffffff : 0xff000000);
+
+	/* Explicit cache flush: no timers, callbacks or console access. */
+	start = (unsigned long)p->fb & ~(ARCH_DMA_MINALIGN - 1UL);
+	end = ALIGN((unsigned long)p->fb + p->line_length * 136,
+		    ARCH_DMA_MINALIGN);
+	flush_dcache_range(start, end);
+}
+
+void rpi5_diag_video(struct udevice *video, unsigned int stage)
+{
+	draw_panel(video, stage, 0);
+	/* Do not retain pointers or write BSS state before relocation. */
+	if (gd->flags & GD_FLG_RELOC)
+		diag_video = video;
+}
+
+void rpi5_diag_attach(struct udevice *console)
+{
+	rpi5_diag_video(console->parent, 304);
+}
+
+struct checkpoint {
+	const char *message;
+	unsigned int code;
+};
+
+static const struct checkpoint checkpoints[] = {
+	{"Logo draw finished", 306},
+	{"Enter console_init_r", 310},
+	{"Leave console_init_r", 311},
+	{"Enter misc_init_r", 312},
+	{"Leave misc_init_r", 313},
+	{"Enter interrupt_init", 314},
+	{"Leave interrupt_init", 315},
+	{"Enter board_late_init", 320},
+	{"RP1 PCI find/probe", 321},
+	{"RP1 PCI command / BAR setup", 322},
+	{"RP1 map BAR", 323},
+	{"RP1 read chip ID", 324},
+	{"RP1 read platform", 325},
+	{"RP1 register reads finished", 326},
+	{"RP1 find/probe returned", 327},
+	{"RP1 child scan", 328},
+	{"RP1 child scan returned", 329},
+	{"Leave board_late_init", 330},
+	{"Enter initr_net", 340},
+	{"MACB probe entered", 341},
+	{"MACB read capabilities", 342},
+	{"MACB enable clocks", 343},
+	{"MACB clocks returned", 344},
+	{"MACB PHY GPIO reset", 345},
+	{"MACB PHY reset returned", 346},
+	{"MACB hardware init", 347},
+	{"MACB hardware init returned", 348},
+	{"MACB MDIO registration", 349},
+	{"MACB MDIO returned", 350},
+	{"Leave initr_net", 351},
+	{"Main loop reached", 360},
+	{"Preboot: PCI / USB start", 361},
+	{"USB init entered", 370},
+	{"USB controller probe", 371},
+	{"USB controller probe returned", 372},
+	{"USB device scan", 373},
+	{"USB device scan returned", 374},
+	{"USB init returned", 375},
+	{"Preboot finished", 380},
+	{"Entering command prompt", 390},
+};
+
+void rpi5_diag_result(const char *message, int result)
+{
+	unsigned int i, code = 399;
+
+	if (!(gd->flags & GD_FLG_RELOC) || !diag_video)
+		return;
+	for (i = 0; i < ARRAY_SIZE(checkpoints); i++) {
+		if (!strcmp(message, checkpoints[i].message)) {
+			code = checkpoints[i].code;
+			break;
+		}
+	}
+	draw_panel(diag_video, code, result);
+}
+
+void rpi5_diag(const char *message)
+{
+	rpi5_diag_result(message, 0);
+}
